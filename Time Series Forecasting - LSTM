# ============================================================
# IMPORTS & ENVIRONMENT SETUP
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader

from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error

from statsmodels.tsa.holtwinters import ExponentialSmoothing
from statsmodels.tsa.arima.model import ARIMA

import shap
import warnings
warnings.filterwarnings("ignore")

torch.manual_seed(42)
np.random.seed(42)

# ============================================================
# DATA GENERATION (TREND + SEASONALITY + NOISE)
# ============================================================

def generate_time_series(n=3000):
    t = np.arange(n)

    trend = 0.005 * t
    daily_seasonality = 2 * np.sin(2 * np.pi * t / 24)
    weekly_seasonality = 1.5 * np.sin(2 * np.pi * t / 168)

    heteroscedastic_noise = np.random.normal(
        0, 0.3 + 0.002 * t, n
    )

    series = 10 + trend + daily_seasonality + weekly_seasonality + heteroscedastic_noise

    return pd.DataFrame({"value": series})

df = generate_time_series()

df.plot(figsize=(12,4), title="Synthetic Electricity Consumption Time Series")
plt.show()

# ============================================================
# TRAIN / VALIDATION / TEST SPLIT
# ============================================================

train_size = int(len(df) * 0.7)
val_size = int(len(df) * 0.15)

train_df = df.iloc[:train_size]
val_df   = df.iloc[train_size:train_size + val_size]
test_df  = df.iloc[train_size + val_size:]

# ============================================================
# SCALING & SEQUENCE CREATION
# ============================================================

scaler = StandardScaler()

train_scaled = scaler.fit_transform(train_df)
val_scaled   = scaler.transform(val_df)
test_scaled  = scaler.transform(test_df)

SEQ_LEN = 48
HORIZON = 24

def create_sequences(data, seq_len, horizon):
    X, y = [], []
    for i in range(len(data) - seq_len - horizon):
        X.append(data[i:i+seq_len])
        y.append(data[i+seq_len:i+seq_len+horizon])
    return np.array(X), np.array(y)

X_train, y_train = create_sequences(train_scaled, SEQ_LEN, HORIZON)
X_val, y_val     = create_sequences(val_scaled, SEQ_LEN, HORIZON)
X_test, y_test   = create_sequences(test_scaled, SEQ_LEN, HORIZON)

# ============================================================
# PYTORCH DATASET & DATALOADER
# ============================================================

class TimeSeriesDataset(Dataset):
    def __init__(self, X, y):
        self.X = torch.tensor(X, dtype=torch.float32)
        self.y = torch.tensor(y, dtype=torch.float32)

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return self.X[idx], self.y[idx]

train_loader = DataLoader(TimeSeriesDataset(X_train, y_train), batch_size=64, shuffle=True)
val_loader   = DataLoader(TimeSeriesDataset(X_val, y_val), batch_size=64)
test_loader  = DataLoader(TimeSeriesDataset(X_test, y_test), batch_size=64)

# ============================================================
# LSTM FORECASTING MODEL
# ============================================================

class LSTMForecaster(nn.Module):
    def __init__(self, input_size=1, hidden_size=64, num_layers=2, horizon=24):
        super().__init__()
        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)
        self.fc = nn.Linear(hidden_size, horizon)

    def forward(self, x):
        out, _ = self.lstm(x)
        return self.fc(out[:, -1, :])

model = LSTMForecaster()

# ============================================================
# MODEL TRAINING
# ============================================================

def train_model(model, train_loader, epochs=20):
    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
    loss_fn = nn.MSELoss()

    for epoch in range(epochs):
        model.train()
        epoch_loss = 0

        for X, y in train_loader:
            optimizer.zero_grad()
            preds = model(X)
            loss = loss_fn(preds, y.squeeze(-1))
            loss.backward()
            optimizer.step()
            epoch_loss += loss.item()

        print(f"Epoch {epoch+1}/{epochs} - Train MSE: {epoch_loss/len(train_loader):.4f}")

train_model(model, train_loader)

# ============================================================
# EVALUATION METRICS
# ============================================================

def mape(y_true, y_pred):
    return np.mean(np.abs((y_true - y_pred) / y_true)) * 100

def evaluate_model(model, loader):
    model.eval()
    preds, trues = [], []

    with torch.no_grad():
        for X, y in loader:
            preds.append(model(X).numpy())
            trues.append(y.numpy())

    preds = np.concatenate(preds)
    trues = np.concatenate(trues)

    return {
        "MAE": mean_absolute_error(trues, preds),
        "RMSE": mean_squared_error(trues, preds, squared=False),
        "MAPE": mape(trues, preds)
    }

lstm_metrics = evaluate_model(model, test_loader)
lstm_metrics

# ============================================================
# BASELINE MODELS (ARIMA & ETS)
# ============================================================

train_series = train_df["value"]
test_series  = test_df["value"]

ets_model = ExponentialSmoothing(
    train_series,
    trend="add",
    seasonal="add",
    seasonal_periods=24
).fit()

ets_forecast = ets_model.forecast(len(test_series))

arima_model = ARIMA(train_series, order=(2,1,2)).fit()
arima_forecast = arima_model.forecast(len(test_series))

baseline_results = {
    "ETS_RMSE": mean_squared_error(test_series, ets_forecast, squared=False),
    "ARIMA_RMSE": mean_squared_error(test_series, arima_forecast, squared=False)
}

baseline_results

# ============================================================
# COMPARATIVE PERFORMANCE TABLE
# ============================================================

results_table = pd.DataFrame([
    {"Model": "LSTM", **lstm_metrics},
    {"Model": "Exponential Smoothing", "RMSE": baseline_results["ETS_RMSE"]},
    {"Model": "ARIMA", "RMSE": baseline_results["ARIMA_RMSE"]}
])

results_table

# ============================================================
# EXPLAINABILITY WITH SHAP (TIME SERIES)
# ============================================================

background = torch.tensor(X_train[:100], dtype=torch.float32)
test_sample = torch.tensor(X_test[:20], dtype=torch.float32)

explainer = shap.DeepExplainer(model, background)
shap_values = explainer.shap_values(test_sample)

shap.summary_plot(
    shap_values[0].reshape(20, -1),
    test_sample.numpy().reshape(20, -1),
    show=True
)
